  "shortcuts": [
    {
      "name": "Today's workout",
      "short_name": "Today",
      "description": "View today's workout plan",
      "url": "/?tab=today",
      "icons": [{ "src": "/icon-192.png?v6", "sizes": "192x192" }]
    },
    {
      "name": "Week plan",
      "short_name": "Week",
      "description": "View the full 7-day plan",
      "url": "/?tab=week",
      "icons": [{ "src": "/icon-192.png?v6", "sizes": "192x192" }]
    },
    {
      "name": "My gear",
      "short_name": "Gear",
      "description": "Change your equipment selection",
      "url": "/?tab=gear",
      "icons": [{ "src": "/icon-192.png?v6", "sizes": "192x192" }]
    }
